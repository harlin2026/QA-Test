# Dashboard / Playwright 可選環境變數（複製為 .env 後填入）

# —— AI 生成測試 ——
# 建議優先在 Dashboard「AI 配置」設定（寫入 qa-data/ai-config.json）
# 以下為無配置檔時的後備：
# AI_API_KEY=sk-...
# OPENAI_API_KEY=sk-...
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# —— Dashboard ——
# DASHBOARD_PORT=3456
# DASHBOARD_NO_OPEN=1

# —— POS 支付／會員（E2E）——
# POS_PAY_METHOD=现金
# POS_MEMBER_PHONE=13800138000
